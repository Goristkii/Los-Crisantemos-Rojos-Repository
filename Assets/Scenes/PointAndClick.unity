  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c9656cd6c90d549bb4b717e08524fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocationIntro
  introText:
  - "Dejando atr\xE1s lugares irrelevantes, por fin llegas a casa. Es un edificio de apartamentos sin nada de especial, como hay miles en esta ciudad y en el pa\xEDs entero. "
  - "El patio est\xE1 tal y como lo recordabas, salvo por un detalle: las nuevas farolas que alumbran la calle. Pero todav\xEDa no puedes entrar. Antes, tienes que ir a esa florister\xEDa. "
  onIntroFinished:
    m_PersistentCalls:
      m_Calls: []
