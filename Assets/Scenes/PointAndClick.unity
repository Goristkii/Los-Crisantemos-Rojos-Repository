  m_Script: {fileID: 11500000, guid: 58c9656cd6c90d549bb4b717e08524fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocationIntro
  introText:
  - "La calle se ensancha y desemboca en un peque\xF1o patio, encajonado entre las fachadas traseras de los bloques de viviendas y unas tiendas sombr\xEDas. Unos tipos con ch\xE1ndal y gorras ocupan los bancos, fumando y bebiendo caf\xE9 en vasos de pl\xE1stico. "
  - "Desde luego, es una suposici\xF3n bastante generosa: la iluminaci\xF3n es tan tenue que lo \xFAnico que puede distinguirse con cierta seguridad son los puntitos incandescentes de los cigarrillos, que aparecen y desaparecen."
  - Una de las figuras, se separa del grupo y se acerca a ti con paso despreocupado.
  onIntroFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1268675498}
        m_TargetAssemblyTypeName: DudeDialogueController, Assembly-CSharp
        m_MethodName: StartEncounter
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
