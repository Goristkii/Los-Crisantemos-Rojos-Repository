  m_Script: {fileID: 11500000, guid: f3fd7933ce17de34baf8bb7313b344a1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableItem
  mirarSequences:
  - messages:
    - "Tu objetivo pasajero y tu tarea inmediata. Su fachada emerge de las profundidades de la calle, atrayendo a gente como t\xFA con su luz c\xE1lida y dejando ver toda clase de vegetaci\xF3n que mira ap\xE1ticamente desde el escaparate. "
    - "Helechos, eucaliptos, el verde carnoso de hojas cuyos nombres ni siquiera conoces, junto con tulipanes, girasoles y flores silvestres, se amalgaman en una mancha exuberante, organizada con una ins\xF3lita dosis de reflexi\xF3n. "
    - "En alg\xFAn lugar de esta jungla aguardan las flores para tu querida madre. Que comience la expedici\xF3n."
  cojerSequences: []
  usarSequences: []
  abrirSequences: []
  itemNeededToUse: 0
  onUsarSuccessEvent:
    m_PersistentCalls:
      m_Calls: []
  itemNeededToAbrir: 4
  textIfAbrirFails:
  - "Entrar ah\xED de nuevo es perder el tiempo. Te hace falta dinero para las flores."
  itemThatBlocksAbrir: 3
  textIfAlreadyHaveItem:
  - "Ya tienes suficientes flores. Es hora de volver a casa, mam\xE1 te espera."
  doorCurrentLocation: {fileID: 0}
  doorTargetLocation: {fileID: 0}
  onMirarEvent:
    m_PersistentCalls:
      m_Calls: []
